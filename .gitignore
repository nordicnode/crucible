# Rust
/target

# Node / client
node_modules/
client/dist/
*.tsbuildinfo

# Generated wasm-bindgen bindings (built by scripts/build-wasm.sh)
client/src/wasm/*
!client/src/wasm/loader.ts
# Committed fallbacks so Vite/tsc resolve without a Rust toolchain (see file
# headers); a real `npm run wasm` build overwrites them with full bindings.
!client/src/wasm/crucible_client_wasm.d.ts
!client/src/wasm/crucible_client_wasm.js
!client/src/wasm/crucible_client_wasm_bg.wasm

# Freebuff local state
.freebuff/

# Runtime data (SQLite lives here)
/data/*
!/data/.gitignore

# Working development plan (local planning doc, not part of the repo)
CRUCIBLE_development_plan.md

# Editor / OS
.DS_Store
*.swp
.omo/
